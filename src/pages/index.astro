---
import "../styles/global.css";
import { Image } from "astro:assets";
import logoImg from "../assets/Logo.png";
import ChefCard from "../components/ChefCard.astro";

// ── Foto chef (tutti export già ritagliati 4× = 1244×700 → 311×175 box) ──
import rosarioImg from "../assets/img1.jpg";
import hannahImg  from "../assets/img2.png";
import michaelImg from "../assets/img3.png";
import giacomoImg from "../assets/img4.png";

// ── Dati dei quattro chef (ordine: Rosario, Hannah, Michael, Giacomo) ──
// Apostrofi e virgolette tipografiche dal documento docs/sections.md.
// Giacomo: un solo spazio in "impact to dishes" (doppio nel Figma, corretto nei docs).
const chefs = [
  {
    name: "ROSARIO",
    role: "Head Chef",
    bio1: "Renowned for his skills in making something out of nothing, magic out of the mundane, and the wonderful from the humdrum.",
    bio2: "Our Head Chef is someone who has no need for the rule book any more - a committed bon viveur and creative genius.",
    image: rosarioImg,
    alt: "Rosario, Head Chef",
  },
  {
    name: "HANNAH",
    role: "Sous Chef",
    bio1: "Our second-in-command brings years of experience of bringing together the best ingredients to create more than the sum of their parts.",
    bio2: "This has allowed this chef to carve out a name for herself as one of the best - and most organised - in the business",
    image: hannahImg,
    alt: "Hannah, Sous Chef",
  },
  {
    name: "MICHAEL",
    role: "Chef De Partie",
    bio1: "Our Station Chief for the evening has a wealth of experience in elevating the right things to make unforgettable experiences.",
    bio2: "An experimental chef with a focus on proteins and a love of Greek yoghurt, they\u2019re sure to take our evening to higher heights",
    image: michaelImg,
    alt: "Michael, Chef De Partie",
  },
  {
    name: "GIACOMO",
    role: "Saucier",
    bio1: "A desire to treat cuisine like science, not art, has allowed this chef to carve a space in the cookbooks that makes for interesting reading.",
    bio2: "A demand for precision and a belief in the \u2018correct\u2019 way to do things brings a precise and measured impact to dishes",
    image: giacomoImg,
    alt: "Giacomo, Saucier",
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Chez Rosario</title>
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="stylesheet" href="https://use.typekit.net/qdn0bcd.css" />
  </head>
  <body class="bg-white">
    <div class="page">
      <div class="frame">

        <!-- fascia a strisce con cupola -->
        <div class="stripes" aria-hidden="true"></div>

        <!-- pannello crema -->
        <div class="panel">
          <span class="dome" aria-hidden="true"></span>

          <!-- ── Sezione 1: Intro ───────────────────────────────── -->
          <section class="intro">

            <!-- Logo: sovrappone le strisce di 16px (mob) / 30px (desk) -->
            <Image
              src={logoImg}
              alt="Chez Rosario"
              widths={[326, 652, 712, 1424]}
              sizes="(min-width: 768px) 712px, 326px"
              width={712}
              height={228}
              class="intro-logo"
            />

            <!-- Tre paragrafi separati da una riga vuota (20px = 1 lh) -->
            <div class="intro-para">
              <p>Chez Rosario is built from many visits and tours across Italy with the experience of a chef born from Britain.</p>
              <p>Tasting from the pot of many families to truly understand the heart of Italian cooking. This is married with a deep rooted englishness of our head chef and the left field thinking of his team to generate a fusion restaurant truly new and truly original.</p>
              <p>We here welcome you with open arms here at Chez Rosario. Where Britalian food is perfected.</p>
            </div>

            <!-- "Hello & Buongiorno": ruotato −9° mob / −6° desk -->
            <div class="intro-hello-wrap">
              <span class="intro-hello">Hello &amp; Buongiorno</span>
            </div>

          </section>
          <!-- ── Fine Intro ─────────────────────────────────────── -->

          <!-- ── Sezione 2: Our Chefs ──────────────────────────── -->
          <section class="our-chefs">

            <h2 class="fit-title" aria-label="Our Chefs">
              {/* Mobile: una sola istanza */}
              <span aria-hidden="true" class="md:hidden">OUR CHEFS</span>
              {/* Desktop: quattro istanze separate da bullet */}
              <span aria-hidden="true" class="hidden md:inline">OUR CHEFS • OUR CHEFS • OUR CHEFS • OUR CHEFS</span>
            </h2>

            <!--
              Griglia chef: 1 col mobile, 2 col da 768px, 4 col da 1400px.
              I dati sono nell'array `chefs` del frontmatter.
            -->
            <div class="chefs-grid">
              {chefs.map((chef) => (
                <ChefCard
                  name={chef.name}
                  role={chef.role}
                  bio1={chef.bio1}
                  bio2={chef.bio2}
                  image={chef.image}
                  alt={chef.alt}
                />
              ))}
            </div>

          </section>
          <!-- ── Fine Our Chefs ─────────────────────────────────── -->

        </div>

        <!-- fascia footer rossa -->
        <footer class="footer-band">
          <span class="footer-word">DELICIOUS</span>
          <span class="footer-word">BRITALIAN</span>
          <span class="footer-word">FOOD</span>
        </footer>

      </div>
    </div>
  </body>
</html>
