---
import "../styles/global.css";
import { Image } from "astro:assets";
import logoImg from "../assets/Logo.png";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Chez Rosario</title>
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="stylesheet" href="https://use.typekit.net/qdn0bcd.css" />
  </head>
  <body class="bg-white">
    <div class="page">
      <div class="frame">

        <!-- fascia a strisce con cupola -->
        <div class="stripes" aria-hidden="true"></div>

        <!-- pannello crema -->
        <div class="panel">
          <span class="dome" aria-hidden="true"></span>

          <!-- ── Sezione 1: Intro ───────────────────────────────── -->
          <section class="intro">

            <!-- Logo: sovrappone le strisce di 16px (mob) / 30px (desk) -->
            <Image
              src={logoImg}
              alt="Chez Rosario"
              widths={[326, 652, 712, 1424]}
              sizes="(min-width: 768px) 712px, 326px"
              width={712}
              height={228}
              class="intro-logo"
            />

            <!-- Tre paragrafi separati da una riga vuota (20px = 1 lh) -->
            <div class="intro-para">
              <p>Chez Rosario is built from many visits and tours across Italy with the experience of a chef born from Britain.</p>
              <p>Tasting from the pot of many families to truly understand the heart of Italian cooking. This is married with a deep rooted englishness of our head chef and the left field thinking of his team to generate a fusion restaurant truly new and truly original.</p>
              <p>We here welcome you with open arms here at Chez Rosario. Where Britalian food is perfected.</p>
            </div>

            <!-- "Hello & Buongiorno": ruotato −9° mob / −6° desk -->
            <div class="intro-hello-wrap">
              <span class="intro-hello">Hello &amp; Buongiorno</span>
            </div>

          </section>
          <!-- ── Fine Intro ─────────────────────────────────────── -->

          <!-- ── Sezione 2: Our Chefs (solo titolo) ───────────── -->
          <section class="our-chefs">

            <h2 class="fit-title" aria-label="Our Chefs">
              {/* Mobile: una sola istanza */}
              <span aria-hidden="true" class="md:hidden">OUR CHEFS</span>
              {/* Desktop: quattro istanze separate da bullet */}
              <span aria-hidden="true" class="hidden md:inline">OUR CHEFS • OUR CHEFS • OUR CHEFS • OUR CHEFS</span>
            </h2>

          </section>
          <!-- ── Fine Our Chefs ─────────────────────────────────── -->

        </div>

        <!-- fascia footer rossa -->
        <footer class="footer-band">
          <span class="footer-word">DELICIOUS</span>
          <span class="footer-word">BRITALIAN</span>
          <span class="footer-word">FOOD</span>
        </footer>

      </div>
    </div>
  </body>
</html>
